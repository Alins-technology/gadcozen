# Base URL of the backend API. Leave as /api for local dev (Vite proxies it to
# http://localhost:5000). In production point it at the deployed API, e.g.
# VITE_API_URL=https://api.gadcozen.com/api
VITE_API_URL=/api

# Public URL of the live store (no trailing slash). Used for canonical URLs,
# social previews and sitemap.xml — set this in Vercel's environment variables.
VITE_SITE_URL=https://gadcozen.com
