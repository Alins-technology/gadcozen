# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/gadco-zen

# Long random string (32+ chars) used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS. Comma-separate several, e.g.
# CLIENT_URL=https://gadcozen.com,https://www.gadcozen.com
# The first one is also used for links inside emails.
CLIENT_URL=http://localhost:5173

# Public URL of this API (optional). Used to build absolute image URLs for
# uploads stored on disk; auto-detected when left empty.
PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Seed / demo credentials (LOCAL DEVELOPMENT ONLY - change before production)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@gadcozen.com
ADMIN_PASSWORD=Admin@12345
DEMO_CUSTOMER_EMAIL=customer@gadcozen.com
DEMO_CUSTOMER_PASSWORD=Customer@12345

# ---------------------------------------------------------------------------
# Store rules (all optional — defaults shown)
# ---------------------------------------------------------------------------
FREE_SHIPPING_THRESHOLD=999
STANDARD_SHIPPING_FEE=79
COD_ENABLED=true
COD_FEE=99
# Unpaid online orders release their stock after this many minutes
PENDING_PAYMENT_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Razorpay (online payments: UPI, cards, netbanking, wallets)
# Dashboard -> Account & Settings -> API Keys. Use rzp_test_ keys for testing,
# rzp_live_ keys after KYC/activation.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add  https://<your-api-domain>/api/payments/razorpay/webhook
# with events: payment.captured, order.paid  — and paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email (SMTP) — order confirmations, password reset, admin notifications.
# Works with Gmail/Google Workspace (app password), Zoho, Hostinger, Brevo, SES...
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GADCO ZEN <orders@gadcozen.com>"
# Store owner's inbox for new-order and contact-form notifications
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Invoice / seller details (printed on the PDF invoice emailed with every order)
# Prices are GST-inclusive; with a GSTIN set the invoice shows the GST split
# (CGST+SGST if the customer is in BUSINESS_STATE, otherwise IGST).
# ---------------------------------------------------------------------------
BUSINESS_BRAND_NAME="GADCO ZEN"
BUSINESS_LEGAL_NAME="Vamah Advanced Hair And Skin LLP"
BUSINESS_ADDRESS=
BUSINESS_STATE=
BUSINESS_GSTIN=
BUSINESS_EMAIL=vamaskinhair@gmail.com
BUSINESS_PHONE="+91 93159 10949"
GST_RATE_PERCENT=18
INVOICE_HSN_CODE=
INVOICE_PREFIX=GZ

# ---------------------------------------------------------------------------
# Image uploads (optional). Without this, admin-uploaded images are saved to
# backend/uploads, which is wiped on every redeploy on Render/Railway-type hosts.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# ---------------------------------------------------------------------------
CLOUDINARY_URL=
CLOUDINARY_FOLDER=gadco-zen/products
